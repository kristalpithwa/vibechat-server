# Server Port
PORT=5000

# Database Connection URL (PostgreSQL)
# For local Postgres: postgresql://USER:PASSWORD@localhost:5432/vibechat?schema=public
# For Prisma Postgres / Supabase / Neon, replace with your connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/vibechat?schema=public"

# Authentication (for JWT tokens)
JWT_SECRET="your-super-secret-jwt-key"
